        }, 
        {
            "name": "schedule", 
            "description": "APIs that exist on the schedule.import.io endpoint"
        }, 
        {
            "name": "api", 
            "description": "APIs that exist on the api.import.io endpoint"
        }, 
        {
            "name": "run.import.io"
        }, 
        {
            "name": "data.import.io"
        }, 
        {
            "name": "extraction.import.io"
        }, 
        {
            "name": "rss.import.io"
        }, 
        {
            "name": "store.import.io"
        }, 
        {
            "name": "schedule.import.io"
        }, 
        {
            "name": "api.import.io"
        }
    ], 
    "basePath": "/", 
    "securityDefinitions": {
        "api_key\"": {
            "name\"": "_apikey", 
            "in\"": "query", 
            "type\"": "apiKey"
        }
    }, 
    "host": "schedule.import.io", 
    "definitions": {
        "ReportRun": {
            "type": "object", 
            "properties": {
                "autoPublish": {
                    "type": "boolean"
                }, 
                "latestConfigId": {
                    "type": "string"
                }, 
                "guid": {
                    "type": "string"
                }, 
                "type": {
                    "type": "string"
                }, 
                "name": {
                    "type": "string"
                }
            }
        }, 
        "Inputs": {
            "type": "object", 
            "properties": {
                "_url": {
                    "required": true, 
                    "type": "string"
                }, 
                "Example Input": {
                    "type": "string"
                }
            }
        }, 
        "Schedule": {
            "type": "object", 
            "properties": {
                "nextRunAt": {
                    "required": false, 
                    "type": "integer", 
                    "format": "int64"
                }, 
                "ownerId": {
                    "required": false, 
                    "type": "string"
                }, 
                "startTimestamp": {
                    "type": "integer", 
                    "format": "int64"
                }, 
                "interval": {
                    "type": "string"
                }, 
                "extractorId": {
                    "type": "string"
                }, 
                "intervalData": {
                    "type": "object", 
                    "properties": {
                        "type": {
                            "type": "string"
                        }, 
                        "minutes": {
                            "type": "string"
                        }, 
                        "time": {
                            "type": "string"
                        }
                    }
                }
            }
        }, 
        "CrawlRun": {
            "type": "object", 
            "properties": {
                "guid": {
                    "type": "string"
                }, 
                "failedUrlCount": {
                    "type": "integer", 
                    "format": "int32"
                }, 
                "rowCount": {
                    "type": "integer", 
                    "format": "int32"
                }, 
                "state": {
                    "type": "string"
                }, 
                "stoppedAt": {
                    "type": "integer", 
                    "format": "int64"
                }, 
                "successUrlCount": {
                    "type": "integer", 
                    "format": "int32"
                }, 
                "startedAt": {
                    "type": "integer", 
                    "format": "int64"
                }, 
                "runtimeConfigId": {
                    "type": "string"
                }, 
                "totalUrlCount": {
                    "type": "integer", 
                    "format": "int32"
                }, 
                "extractorId": {
                    "type": "string"
                }, 
                "urlListId": {
                    "type": "string"
                }
            }
        }, 
        "APIError": {
            "type": "object", 
            "properties": {
                "message": {
                    "type": "string", 
                    "description": "A message containing a brief description of the error"
                }, 
                "code": {
                    "type": "integer", 
                    "description": "Internal error code", 
                    "format": "int"
                }, 
                "error": {
                    "type": "string", 
                    "description": "(deprecated) A message containing a brief description of the error"
                }
            }
        }, 
        "ObjectStoreSearchResult": {
            "type": "object", 
            "properties": {
                "hits": {
                    "type": "object", 
                    "properties": {
                        "hits": {
                            "items": {
                                "type": "object", 
                                "properties": {
                                    "_score": {
                                        "type": "integer"
                                    }, 
                                    "_type": {
                                        "type": "string"
                                    }, 
                                    "_id": {
                                        "type": "string"
                                    }, 
                                    "fields": {
                                        "$ref": "#/definitions/CrawlRun"
                                    }
                                }
                            }, 
                            "type": "array"
                        }, 
                        "total": {
                            "type": "integer"
                        }
                    }
                }, 
                "took": {
                    "type": "integer"
                }, 
                "timed_out": {
                    "type": "boolean"
                }
            }
        }, 
        "ScheduleRequest": {
            "type": "object", 
            "properties": {
                "startTimestamp": {
                    "required": false, 
                    "type": "integer", 
                    "example": 1485448509727, 
                    "format": "int64"
                }, 
                "interval": {
                    "required": true, 
                    "type": "string", 
                    "example": "15 * * * *"
                }, 
                "extractorId": {
                    "required": true, 
                    "type": "string", 
                    "example": "00000000-0000-0000-0000-000000000000"
                }
            }
        }, 
        "Report": {
            "type": "object", 
            "properties": {
                "status": {
                    "type": "string"
                }, 
                "name": {
                    "type": "string"
                }, 
                "summary": {
                    "type": "object"
                }, 
                "reportId": {
                    "type": "string"
                }, 
                "published": {
                    "type": "boolean"
                }, 
                "configId": {
                    "type": "string"
                }, 
                "guid": {
                    "type": "string"
                }, 
                "type": {
                    "type": "string"
                }
            }
        }, 
        "QueryResponse": {
            "type": "object", 
            "properties": {
                "sequenceNumber": {
                    "type": "integer", 
                    "format": "int32"
                }, 
                "url": {
                    "type": "string"
                }, 
                "timestamp": {
                    "type": "integer", 
                    "format": "int64"
                }, 
                "extractorData": {
                    "type": "object"
                }, 
                "exceptionType": {
                    "type": "string"
                }, 
                "error": {
                    "type": "string"
                }, 
                "pageData": {
                    "type": "object"
                }, 
                "runtimeConfigId": {
                    "type": "string"
                }
            }
        }
    }, 
    "swagger": "2.0"
}